# ── 프로덕션(oracle A1) 배포용 환경변수 — /opt/sandcorp-flow/.env 로 복사해 채운다 ──────────────
# docs/deployment.md 참조. 이미지·git에 절대 커밋하지 말 것(.env는 gitignore).

# 반드시 prod 설정 모듈을 지정 — 없으면 dev 설정으로 떠서 DEBUG·평문키·SQLite류 위험.
DJANGO_SETTINGS_MODULE=config.settings.prod

# ⚠️ SECRET_KEY는 Django 시크릿이자 '테넌트 provider API 키 암호화(Fernet) 키'의 파생원이다
#    (apps/tenants/crypto.py). 한번 정하면 절대 바꾸지 말 것 — 바꾸면 저장된 모든 테넌트 키가
#    복호화 불가가 된다. 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-strong-random-and-never-rotate

# 서비스 도메인 flow.sandcorp.co.kr(NPM이 TLS 종단). 쉼표로 여러 개.
# ⚠️ 127.0.0.1·localhost를 반드시 포함 — 컨테이너 healthcheck와 배포 스모크가 /api/health를
#    127.0.0.1로 치는데, 빠지면 Django가 400(DisallowedHost)을 내 rollout/스모크가 실패한다.
#    (prod.py가 둘을 항상 덧붙이지만 명시해 두는 편이 읽기 쉽다.)
ALLOWED_HOSTS=flow.sandcorp.co.kr,127.0.0.1,localhost
# https 출처(쉼표로 여러 개). JWT API라 CSRF는 비필수지만 Django admin 등을 위해 명시한다.
CSRF_TRUSTED_ORIGINS=https://flow.sandcorp.co.kr
# 쿠키·HTTPS: prod.py가 SESSION_COOKIE_SECURE·CSRF_COOKIE_SECURE를 켜고
#   NPM의 X-Forwarded-Proto를 신뢰한다(HTTPS 강제는 NPM 몫, 앱은 리디렉션하지 않는다) — env로 바꿀 것이 없다(NPM이 https 종단이어야 한다).
# CORS: 위젯이 고객 사이트에 임베드되므로 base.py가 모든 출처를 허용한다(쿠키 인증이 아니라
#   Bearer JWT라 안전). 별도 env 없음.

# ── Database (compose의 db 서비스) — DB_NAME/USER/PASSWORD는 db 컨테이너 초기화에도 쓰인다 ──
DB_HOST=db
DB_PORT=5432
DB_NAME=sandcorp_flow
DB_USER=postgres
DB_PASSWORD=change-me-strong-db-password

# ── Redis (compose의 redis 서비스) — Celery broker/result도 이 값을 쓴다 ──
REDIS_URL=redis://redis:6379/0

# ── EventBus(Redis Streams) 토픽 ──
EVENTS_TOPIC=events.session

# ── Langfuse 토큰/트레이스 관찰 (issue 186) — 미설정이면 완전 no-op(안전) ──
# A1 셀프호스트(docker-compose.langfuse.yml)로 띄운 뒤, Langfuse UI에서 프로젝트 API 키를 발급해 입력.
# LANGFUSE_HOST=http://langfuse-web:3000  (같은 네트워크) 또는 NPM 도메인.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_CAPTURE_CONTENT=true   # false면 프롬프트/응답 본문 마스킹(킬스위치)

# ── sandcorp-auth 토큰 검증(#20, ADR-0028) — Operator API는 대표 토큰 + admin 스코프만 ──
# 대표 계정 username(sandcorp-auth 대표 토큰의 sub). 비우면 대표 토큰이 모두 거부된다.
AUTH_OWNER_SUB=farrar142
# 아래 셋은 기본값 그대로면 적지 않아도 된다.
# AUTH_ISSUER=https://auth.sandcorp.co.kr
# AUTH_JWKS_URL=https://auth.sandcorp.co.kr/.well-known/jwks.json
# AUTH_RESOURCE=https://flow.sandcorp.co.kr/api
# ── 관리 화면 Operator 로그인(#21) — sandcorp-auth 기밀 클라이언트(docs/deployment.md 「서버 쪽 할 일」 7번) ──
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# sandcorp-auth에 등록한 리디렉션 URI와 문자 하나까지 같아야 한다(기본값이 이 값).
AUTH_REDIRECT_URI=https://flow.sandcorp.co.kr/api/auth/callback
# 탈퇴 웹훅 서명 비밀 — `clients webhook --client-id <id> --url https://flow.sandcorp.co.kr/api/auth/webhook`로 발급.
# 수신부(/api/auth/webhook)는 별도 티켓이다. 지금은 이름만.
AUTH_WEBHOOK_SECRET=
# 아래 셋은 기본값 그대로면 적지 않아도 된다.
# AUTH_AUTHORIZE_URL=https://auth.sandcorp.co.kr/authorize
# AUTH_TOKEN_URL=https://auth.sandcorp.co.kr/token
# AUTH_LOGIN_REDIRECT=/admin-ui/operator

# ── nginx 호스트 노출 포트 — NPM이 <A1 호스트>:이 포트로 포워딩한다 ──
# ⚠️ Oracle 보안목록엔 열지 말 것(같은 호스트의 NPM만 접근). 공개는 NPM의 443만.
NGINX_PORT=8080

# ── 플랫폼 키·체험 한도(#41, ADR-0026) ──
# 값은 대장 보관. 비어 있으면 Provider 없는 테넌트의 챗이 정중히 멈추고 관리 화면이 「준비되지 않음」을 알린다.
# 「Sandcorp」 테넌트 시드(seed_sandcorp, #39)도 이 키·아래 두 모델로 LLM·임베딩·OCR Provider를 맞춘다(DB에는 암호화 저장).
# prod는 PLATFORM_DEFAULT_PROVIDERS_ENABLED=False(prod.py 고정, env로 못 바꾼다).
PLATFORM_OPENAI_API_KEY=
# 아래는 코드 기본값과 같다(바꿀 때만 적는다).
PLATFORM_LLM_MODEL=gpt-4o-mini
PLATFORM_EMBED_MODEL=text-embedding-3-small
TRIAL_TURNS=200
# Try Session(/try) 한도(#135). /try 화면을 API와 다른 호스트에서 띄울 때만 TRY_ALLOWED_ORIGINS를 넣는다.
TRY_SESSION_TURNS=20
TRY_SESSIONS_PER_IP_PER_DAY=3
TRY_DAILY_BUDGET_USD=5
TRY_QUOTA_TIMEZONE=Asia/Seoul
# TRY_ALLOWED_ORIGINS=https://sandcorp.co.kr

# ── 선택(기본값 있음) ──
# 챗 토큰 스트리밍 킬스위치(기본 on). provider 호환 문제 시 false로 전면 끄기.
CHAT_STREAMING_ENABLED=true
# 공개 URL 레이트리밋(분당). 기본 visitor=20 / tenant=300.
CHAT_RATE_LIMIT_PER_VISITOR=20
CHAT_RATE_LIMIT_PER_TENANT=300
# 공개 흐름 보기(/api/public/flows/{slug}/, #39) IP당 분당 요청 수. 기본 60.
PUBLIC_FLOW_RATE_LIMIT_PER_MINUTE=60

# 방문 지표 스니펫(#154) — 값을 넣으면 nginx가 랜딩(/·/terms·/privacy)과 admin(/admin-ui/) head 끝에
# <script defer src=… data-site=…>를 넣는다(위젯 /embed/·/chatbot/ 에는 안 넣음). 비우면 태그 자체가 없다.
# 빌드가 아니라 nginx 컨테이너 시작 때 반영되므로 바꾼 뒤 nginx 재생성이 필요하다(docs/deployment.md).
METRICS_SNIPPET_URL=
# METRICS_SITE_KEY=flow   # 기본 flow

# 운영 오류 수집(GlitchTip, #308) — 비면 SDK 꺼짐(dev·시험은 비워 둔다). 운영 값은 대장이 넣는다(값을 문서·로그에 적지 않는다).
# compose 가 컨테이너 env SENTRY_DSN 으로 넘긴다: BACKEND → api·worker·worker-chat·events, ADMIN → admin-init, WIDGET → widget-init.
# release(SENTRY_RELEASE)는 배포 sha(IMAGE_TAG)라 여기 두지 않는다.
SENTRY_DSN_BACKEND=
SENTRY_DSN_ADMIN=
SENTRY_DSN_WIDGET=

# 참고:
# - 이미지 태그(IMAGE_TAG)는 deploy.sh가 배포 SHA로 주입하므로 여기 두지 않는다.
# - prod는 PLATFORM_DEFAULT_PROVIDERS_ENABLED=False라 OPEN_ROUTER_*·OLLAMA_*가
#   불필요하다 — LLM·Embedding·OCR은 테넌트가 자기 Provider를 설정한다(ADR-0012).
#   Provider가 없는 테넌트는 체험 한도 안에서만 PLATFORM_OPENAI_API_KEY로 돈다(#41).
