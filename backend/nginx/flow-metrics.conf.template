# 방문 지표 스니펫(#154) — nginx 공식 이미지의 envsubst 템플릿(/etc/nginx/templates → conf.d/flow-metrics.conf).
# METRICS_SNIPPET_URL 이 http(s):// 로 시작할 때만 $flow_metrics_head 가 <script> 태그가 되고,
# 비면 빈 문자열이라 sub_filter 가 아무것도 넣지 않는다(빈 src 태그 없음). 빌드가 아니라 컨테이너 시작 때 정해진다.
# nginx.oracle.conf 가 http 블록에서 include 하고, 랜딩·약관·처리방침·admin location 에서만 sub_filter 로 쓴다.
map "${METRICS_SNIPPET_URL}" $flow_metrics_head {
    default "";
    "~^https?://" '<script defer src="${METRICS_SNIPPET_URL}" data-site="${METRICS_SITE_KEY}"></script>';
}

# iframe 허용 출처(#179) — CSP frame-ancestors 만 낸다(X-Frame-Options 는 앱이 내지 않는다. 운영 XFO 는 NPMplus 프록시 몫).
# TRY_EMBED_ORIGINS(공백 구분 출처 목록)는 /admin-ui/try 문서에만 'self' 뒤에 붙고, 비면 'self' 만이다.
# $request_uri 로 판정한다: SPA 폴백(try_files)이 $uri 를 /admin-ui/index.html 로 바꿔 버리기 때문.
# 정확히 /admin-ui/try, /admin-ui/try/…, /admin-ui/try?… 만 — /admin-ui/tryX 는 해당 없음.
map "${TRY_EMBED_ORIGINS}" $flow_try_ancestors {
    default "'self' ${TRY_EMBED_ORIGINS}";
    "" "'self'";
}
map $request_uri $flow_frame_ancestors {
    default "'self'";
    "~^/admin-ui/try(/|\\?|$)" $flow_try_ancestors;
}
