#!/usr/bin/env bash
# orval 생성물 드리프트 차단 (ADR-0014, issue 111).
# 백엔드 Ninja Schema/엔드포인트(또는 orval 설정) 변경이 스테이징됐는데 admin 클라이언트를
# 재생성·스테이징하지 않았으면 커밋을 막는다. codegen은 docker로 실행한다(CLAUDE.md 규칙).
#
# 활성화: git config core.hooksPath scripts/hooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# 시험의 고정 시간 대기 차단(#259) — grep 이라 docker 없이 1초 안에 끝난다.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(e2e/tests/|admin/src/|widget/src/)'; then
  bash scripts/lint-fixed-waits.sh || exit 1
fi

# 백엔드 스키마에 영향 줄 수 있는 변경이 스테이징됐는가?
#  - admin/orval.config.ts
#  - backend 비테스트·비마이그레이션 .py 중 이름이 api/schema(s)로 끝나거나(예: api.py, schemas.py),
#    스테이징된 내용이 ninja·pydantic을 import하는 파일(스키마 모듈·인증/권한 등 OpenAPI에 닿는 모듈).
#    그 밖의 .py(모델·서비스 등)만 바뀐 커밋은 docker를 띄우지 않고 통과한다.
needs_check=0
while IFS= read -r f; do
  case "$f" in
    admin/orval.config.ts) needs_check=1; break ;;
    backend/*.py)
      case "$f" in */tests/*|*/migrations/*|*/test_*.py|*/conftest.py) continue ;; esac
      case "$f" in
        */api.py|*/schema.py|*/schemas.py|*/*_api.py|*/*_schemas.py) needs_check=1; break ;;
      esac
      if git show ":$f" 2>/dev/null | grep -qE '^\s*(from|import) +(ninja|pydantic)\b'; then
        needs_check=1; break
      fi ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)
[ "$needs_check" = 1 ] || exit 0

echo "[pre-commit] 백엔드 API 변경 감지 → admin 클라이언트 재생성·드리프트 검사…"
bash scripts/gen-admin-api.sh >/dev/null 2>&1 || { echo "✗ codegen 실패"; exit 1; }

if ! git diff --exit-code -- admin/openapi.json admin/src/generated >/dev/null 2>&1; then
  echo "✗ 생성물이 백엔드 스키마와 어긋났습니다."
  echo "  → 'bash scripts/gen-admin-api.sh' 실행 후 admin/openapi.json·admin/src/generated 변경분을 스테이징하세요."
  exit 1
fi

echo "✓ admin 클라이언트가 백엔드 스키마와 최신 상태입니다."
