# ── 개발(dev) 환경변수 — cp .env.example .env. dev 설정(config.settings.dev) 기준 ──

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=sandcorp_flow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis (SSE pub/sub + Celery 브로커 + EventBus + 레이트리밋·세션 락)
REDIS_URL=redis://redis:6379/0

# EventBus(Redis Streams) 토픽
EVENTS_TOPIC=events.session

# 챗 토큰 스트리밍 킬스위치(기본 on)
CHAT_STREAMING_ENABLED=true

# OpenRouter — dev 플랫폼 기본 LLM(PLATFORM_DEFAULT_PROVIDERS_ENABLED=true)
OPEN_ROUTER_API_KEY=your-openrouter-api-key
OPEN_ROUTER_DEFAULT_MODEL=openrouter/owl-alpha
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# 플랫폼 키·체험 한도(#41) — dev는 위 OpenRouter/ollama 폴백을 쓰므로 비워 둔다(운영 전용).
# PLATFORM_OPENAI_API_KEY=
# PLATFORM_LLM_MODEL=gpt-4o-mini
# PLATFORM_EMBED_MODEL=text-embedding-3-small
# TRIAL_TURNS=200

# Ollama — dev 기본 임베딩(bge-m3). 기본값 있어 생략 가능
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=bge-m3

# ── Langfuse 토큰/트레이스 관찰 (선택) — 미설정이면 완전 no-op ──
# 로컬에서 Langfuse를 띄워 실연동을 테스트하려면 키 입력(docker-compose.langfuse.yml 참고):
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_CAPTURE_CONTENT=true

# sandcorp-auth(#20·#21, ADR-0028) — Operator = 대표 토큰 + admin 스코프. Operator 비밀번호 로그인은 없다.
# AUTH_OWNER_SUB가 비면 대표 토큰은 모두 거부된다.
# AUTH_OWNER_SUB=farrar142
# AUTH_ISSUER=https://auth.sandcorp.co.kr
# AUTH_JWKS_URL=https://auth.sandcorp.co.kr/.well-known/jwks.json
# AUTH_RESOURCE=https://flow.sandcorp.co.kr/api
# 관리 화면 로그인(#21) — sandcorp-auth 기밀 클라이언트. 비우면 로그인 버튼이 「설정되지 않음」 거절 화면으로 간다.
# 개발에서는 dev용 클라이언트를 따로 등록하고 리디렉션 주소를 admin dev 서버(vite가 /api를 넘긴다)로 둔다.
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_REDIRECT_URI=http://localhost:5174/api/auth/callback
# AUTH_LOGIN_REDIRECT=/admin-ui/operator
# AUTH_MEMBER_REDIRECT=/admin-ui/tenant
# 탈퇴 웹훅(https://flow.sandcorp.co.kr/api/auth/webhook) 서명 비밀 — 수신부는 별도 티켓, 지금은 이름만.
# AUTH_WEBHOOK_SECRET=
